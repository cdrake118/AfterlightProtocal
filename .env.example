# Afterlight Protocol prototype automation environment.
# Copy to your local shell/profile or CI secret store; do not commit real secrets.

# Steam depot planning. Defaults are safe dry-run placeholders.
STEAM_APP_ID=000000
STEAM_DEPOT_ID=000001
STEAM_BRANCH=prototype
STEAM_BUILD_DESC=Afterlight Protocol Prototype 0.1.0 web-static

# SteamCMD real-upload configuration. Leave blank for dry runs.
STEAMCMD_PATH=
STEAM_USERNAME=
STEAM_PASSWORD=
STEAM_UPLOAD=0

# Private beta planning.
PLAYTEST_BRANCH=private-beta
PLAYTEST_WAVE_SIZE=10
PLAYTEST_FEEDBACK_MODE=local-archive
PLAYTEST_FEEDBACK_URL=TBD
PLAYTEST_FEEDBACK_DIR=playtest-feedback-inbox

# Store and localization planning.
STORE_PAGE_STATE=draft
STORE_LANGUAGES=English,French,German,Spanish - Latin America,Japanese
CAPTURE_BASE_URL=http://127.0.0.1:5173/
